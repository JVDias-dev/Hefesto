generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  ANALYZING
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String
  status       ProjectStatus @default(DRAFT)
  technologies String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases   ProjectPhase[]
  analyses Analysis[]
}

model ProjectPhase {
  id           String   @id @default(cuid())
  name         String
  description  String
  order        Int
  technologies String[]

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([projectId])
}

model Task {
  id           String       @id @default(cuid())
  name         String
  description  String
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  order        Int
  technologies String[]

  phaseId String
  phase   ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phaseId])
}

model Analysis {
  id      String @id @default(cuid())
  prompt  String
  content String
  model   String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}
